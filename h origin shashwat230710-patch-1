[32m+[m[32m## 6. Docker Containerization (Production Deployment)[m
[32m+[m
[32m+[m[32m### 6.1. Backend `Dockerfile`[m
[32m+[m[32mCreate `Dockerfile.backend`:[m
[32m+[m[32m```dockerfile[m
[32m+[m[32mFROM python:3.11-slim[m
[32m+[m[32mWORKDIR /app[m
[32m+[m[32mRUN apt-get update && apt-get install -y --no-install-recommends build-essential && rm -rf /var/lib/apt/lists/*[m
[32m+[m[32mCOPY requirements.txt .[m
[32m+[m[32mRUN pip install --no-cache-dir -r requirements.txt[m
[32m+[m[32mCOPY backend/ ./backend/[m
[32m+[m[32mCOPY ml/ ./ml/[m
[32m+[m[32mCOPY src/ ./src/[m
[32m+[m[32mCOPY data/processed/ ./data/processed/[m
[32m+[m[32mEXPOSE 8000[m
[32m+[m[32mCMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"][m
[32m+[m[32m```[m
[32m+[m
[32m+[m[32m### 6.2. Frontend `Dockerfile`[m
[32m+[m[32mCreate `Dockerfile.frontend`:[m
[32m+[m[32m```dockerfile[m
[32m+[m[32mFROM node:18-alpine AS build[m
[32m+[m[32mWORKDIR /app[m
[32m+[m[32mCOPY frontend/package*.json ./[m
[32m+[m[32mRUN npm ci[m
[32m+[m[32mCOPY frontend/ ./[m
[32m+[m[32mRUN npm run build[m
[32m+[m
[32m+[m[32mFROM nginx:alpine[m
[32m+[m[32mCOPY --from=build /app/dist /usr/share/nginx/html[m
[32m+[m[32mEXPOSE 80[m
[32m+[m[32mCMD ["nginx", "-g", "daemon off;"][m
[32m+[m[32m```[m
