# ─────────────────────────────────────────────────────────────────────────────
# EconoCausal — Environment Configuration Template
# Copy this file to .env and adjust values as needed.
# NEVER commit the actual .env file with sensitive credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Project metadata
PROJECT_NAME=EconoCausal
PROJECT_REF=ITS/DSML/1147
ENVIRONMENT=development

# Reproducibility
RANDOM_SEED=42

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Data paths (relative to repository root)
DATA_RAW_PATH=data/raw/mock_retail_campaign.csv
DATA_PROCESSED_PATH=data/processed/cleaned_retail_campaign.csv
REPORTS_DIR=reports

# Dashboard / Frontend settings
VITE_PORT=5173
VITE_API_URL=http://localhost:8000
