# ─────────────────────────────────────────────────────────────────────────────
# EconoCausal — Environment Configuration Example
# Project Reference: ITS/DSML/1147
# Note: Copy this file to .env and adjust variables as needed.
# Do NOT commit private credentials or secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Backend Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend Application Configuration
VITE_API_URL=http://localhost:8000

# Default Prescriptive Campaign Parameters
DEFAULT_BUDGET_INR=5000.0
DEFAULT_DISCOUNT_AMOUNT_INR=10.0
DEFAULT_CURRENCY=INR
RANDOM_SEED=42

# Data Drift Auditing Thresholds
PSI_STABLE_THRESHOLD=0.10
PSI_MODERATE_THRESHOLD=0.25
P_VALUE_SIGNIFICANCE=0.05
MISSING_RATE_ALERT_DELTA=0.05
MAX_UPLOAD_SIZE_MB=50
